# ---------------------------------------------------------------------------
# Copy this file to `.env` (project root) and fill in your values.
#   cp .env.example .env
# The backend reads `backend/.env` first, then this root `.env`.
# Real process environment variables always win over both.
# ---------------------------------------------------------------------------

# --- Groq (required) -------------------------------------------------------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Vision-capable model. Groq's current multimodal model is qwen/qwen3.8-27b
# (supports text, up to 3 images per request, 2048 tokens per image).
GROQ_MODEL=qwen/qwen3.8-27b

# OpenAI-compatible base URL (change only for testing / a gateway).
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# --- Server ----------------------------------------------------------------
PORT=3001

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173

# --- Limits & behaviour ----------------------------------------------------
MAX_IMAGE_SIZE_MB=5
MAX_MESSAGE_LENGTH=4000
MAX_HISTORY_MESSAGES=20
MAX_CONVERSATIONS=500
GROQ_MAX_COMPLETION_TOKENS=2048
GROQ_TEMPERATURE=0.6
GROQ_TIMEOUT_MS=60000

# Optional: "low" | "medium" | "high" | "none" for reasoning-capable models.
# Leave empty to use the provider default.
GROQ_REASONING_EFFORT=

# Optional: override the system prompt sent as the first message.
SYSTEM_PROMPT=
